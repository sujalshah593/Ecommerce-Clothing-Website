# MongoDB
MONGO_URL=mongodb+srv://<username>:<password>@<cluster-host>/mern
# Per-process bounded pool sizes. minPoolSize remains 0.
MONGO_API_MAX_POOL_SIZE=30
MONGO_WORKER_MAX_POOL_SIZE=15
MONGO_MAX_IDLE_TIME_MS=60000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000

# Temporary inventory reservation duration (minutes; default: 10)
INVENTORY_RESERVATION_DURATION_MINUTES=10
# Worker recovery scan interval (milliseconds; minimum 10000)
RESERVATION_RECOVERY_INTERVAL_MS=60000

# JWT
JWT_SECRET=your_jwt_secret_here

# Server
PORT=5000
NODE_ENV=development

# Development admin seed (run: npm run seed:admin)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123

# Public application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
PASSWORD_RESET_URL=http://localhost:5173/login

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (SMTP)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Redis
REDIS_URL=redis://127.0.0.1:6379
# For Redis Cloud / Upstash / Production:
# REDIS_URL=rediss://:your_password@your-host:6380
